{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!dotfiles/agents/.skill-lock.json",
      "!.agents/skills",
      "!dotfiles/agents/skills"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    }
  }
}

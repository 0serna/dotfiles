{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!dotfiles/pi/agent/settings.json",
      "!dotfiles/agents/.skill-lock.json",
      "!.agents/skills",
      "!dotfiles/agents/skills"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "includes": ["**/*.{js,jsx,ts,tsx,json,jsonc}"]
  }
}

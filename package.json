{
  "name": "dotfiles",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "link": "tsx src/installer/dotfiles-installer.ts",
    "link:main": "sh scripts/link-main.sh",
    "agents:update": "tsx src/skills/agents-update.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@opencode/plugin": "2.0.14",
    "@types/node": "^24.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched"
  }
}

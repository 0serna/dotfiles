[Unit]
Description=Set default audio output volume to 50%
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=oneshot
ExecStart=%h/.config/systemd/user/set-default-volume.sh
RemainAfterExit=yes
TimeoutStartSec=45

[Install]
WantedBy=default.target

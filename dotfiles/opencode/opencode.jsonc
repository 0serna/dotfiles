{
  "$schema": "https://opencode.ai/config.json",
  "lsp": false,
  "snapshot": false,
  "disabled_providers": ["cloudflare-ai-gateway", "cloudflare-workers-ai"],
  "agent": {
    "main": {
      "mode": "primary",
      "color": "primary",
    },
    "plan": { "disable": true },
    "build": { "disable": true },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
    },
  },
}

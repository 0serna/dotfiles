{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "websearch": {
    "provider": "random"
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--cdp-endpoint=chrome"
        ]
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ]
}

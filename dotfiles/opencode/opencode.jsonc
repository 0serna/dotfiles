{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "websearch": {
    "provider": "random"
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "browser",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "plugins": ["@dietrichgebert/ponytail"]
}

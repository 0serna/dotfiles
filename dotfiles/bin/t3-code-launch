#!/usr/bin/env bash
set -euo pipefail

# Launch the newest T3-Code AppImage in ~/Applications.
# Usage: t3-code-launch [--no-sandbox] [args...]
dir="${APPIMAGE_DIR:-$HOME/Applications}"
mapfile -t files < <(printf '%s\n' "$dir"/T3-Code-*.AppImage 2>/dev/null | sort -V)
if (( ${#files[@]} == 0 )); then
  echo "t3-code-launch: no T3-Code-*.AppImage in $dir" >&2
  exit 1
fi
exec "${files[-1]}" "$@"

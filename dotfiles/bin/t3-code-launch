#!/usr/bin/env bash
set -euo pipefail

# Usage: t3-code-launch [--no-sandbox] [args...]
dir="${APPIMAGE_DIR:-$HOME/Applications}"
mapfile -t files < <(compgen -G "$dir/T3-Code-*.AppImage" | sort -V)
if (( ${#files[@]} == 0 )); then
  echo "t3-code-launch: no T3-Code-*.AppImage in $dir" >&2
  exit 1
fi
exec "${files[-1]}" "$@"

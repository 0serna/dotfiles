#!/usr/bin/env bash
set -euo pipefail

# Launch the newest Paseo AppImage in ~/Applications.
# Usage: paseo-launch [args...]
dir="${APPIMAGE_DIR:-$HOME/Applications}"
mapfile -t files < <(printf '%s\n' "$dir"/Paseo-*.AppImage 2>/dev/null | sort -V)
if (( ${#files[@]} == 0 )); then
  echo "paseo-launch: no Paseo-*.AppImage in $dir" >&2
  exit 1
fi
exec "${files[-1]}" "$@"

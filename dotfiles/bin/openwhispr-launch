#!/usr/bin/env bash
set -euo pipefail

# Usage: openwhispr-launch [args...]
dir="${APPIMAGE_DIR:-$HOME/Applications}"
mapfile -t files < <(compgen -G "$dir/OpenWhispr-*.AppImage" | sort -V)
if (( ${#files[@]} == 0 )); then
  echo "openwhispr-launch: no OpenWhispr-*.AppImage in $dir" >&2
  exit 1
fi
exec "${files[-1]}" "$@"
